[Unit]
Description=Boost marketplace API
After=network-online.target
Wants=network-online.target
[Service]
Type=simple
User=boost
Group=boost
WorkingDirectory=/srv/boost/current
EnvironmentFile=/etc/boost/production.env
ExecStart=/usr/bin/java -Dfile.encoding=UTF-8 -Duser.timezone=UTC -Xms256m -Xmx1024m -jar /srv/boost/current/ruoyi-admin.jar
Restart=on-failure
RestartSec=10
TimeoutStopSec=45
SuccessExitStatus=143
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/boost/shared
UMask=0077
[Install]
WantedBy=multi-user.target
