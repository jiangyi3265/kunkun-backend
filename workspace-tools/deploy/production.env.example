# Copy to a private path outside the repository, restrict file access, and fill all required values.
SPRING_PROFILES_ACTIVE=prod
BOOST_DB_URL=jdbc:mysql://127.0.0.1:3306/boost_production?useUnicode=true&characterEncoding=utf8&connectionTimeZone=UTC&forceConnectionTimeZoneToSession=true
BOOST_DB_USER=boost_app
BOOST_DB_PASSWORD=
BOOST_REDIS_HOST=127.0.0.1
BOOST_REDIS_DATABASE=1
BOOST_REDIS_PASSWORD=
BOOST_JWT_SECRET=
BOOST_MEDIA_SIGNING_KEY=
BOOST_MEDIA_DIR=/srv/boost/shared/private-media
BOOST_UPLOAD_DIR=/srv/boost/shared/public-uploads
BOOST_LOG_DIR=/srv/boost/shared/logs
BOOST_PUBLIC_API_ORIGIN=
BOOST_WEB_ORIGINS=
BOOST_OPERATOR=
BOOST_PRIVACY_EMAIL=
BOOST_RETENTION=
BOOST_POLICY_VERSION=
BOOST_POLICY_DATE=
BOOST_WX_APP_ID=
BOOST_WX_APP_SECRET=
# Deferred payment mode rejects payment, refund, settlement and withdrawal writes.
BOOST_PAYMENTS_ENABLED=false
# Free points only; leave closed until the source rules and native flow are verified.
BOOST_FREE_POINTS_DRAW_ENABLED=false
# The merchant fields below are required only when payments are deliberately enabled.
BOOST_WX_MERCHANT_ID=
BOOST_WX_MERCHANT_SERIAL=
BOOST_WX_PRIVATE_KEY_PATH=
BOOST_WX_PLATFORM_KEY_PATH=
BOOST_WX_PLATFORM_KEY_ID=
BOOST_WX_API_V3_KEY=
BOOST_WX_TRANSFER_SCENE=
BOOST_WX_TRANSFER_REPORTS=[]
# No real-money signup subsidy unless a budget is deliberately allocated.
BOOST_CAMPAIGN_DAILY_CENTS=0
BOOST_CAMPAIGN_TOTAL_CENTS=0
